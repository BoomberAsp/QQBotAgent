# ============================================================================
# QQBot 环境变量说明（复制为 .env 后填写）
#   cp .env.example .env
#
# 约定：
#   * 本文件是 .env 的「说明文档 + 模板」，逐行注释每个变量的含义与取值。
#   * 模型凭据遵循「models_settings.json 优先、.env 回退」：
#     在 config/models_settings.json 中为某模型段填写 api_key/api_base 后，
#     该段即覆盖 .env 的 DEEPSEEK_API_KEY / DEEPSEEK_API_BASE。
#     只有 JSON 段留空（或文件缺失）时，才回退到 .env 的 DeepSeek 配置。
#   * 布尔/列表值直接写 JSON 字面量，例如 SUPERUSERS=["123","456"]。
# ============================================================================

# ── NoneBot 服务 ────────────────────────────────────────────────────────────
DRIVER=~fastapi          # NoneBot 驱动，保持 ~fastapi
HOST=0.0.0.0             # 监听地址
PORT=8081                # 监听端口（NapCat 反向 WS 连接到此端口）

# ── OneBot / QQ 协议 ────────────────────────────────────────────────────────
ONEBOT_ACCESS_TOKEN=你的Token   # 必须与 NapCat WebUI 中配置的 token 完全一致
COMMAND_START=["/", ""]        # 命令起始符（"" 表示也响应纯文本）
COMMAND_SEP=[" "]              # 命令与参数分隔符

# ── 权限（QQ 号，JSON 数组字符串）───────────────────────────────────────────
SUPERUSERS=["管理员QQ号1", "管理员QQ号2"]   # 管理员（全部工具）
VIP_USERS=["VIPQQ号1"]                      # 可选；VIP（部分特权工具）

# ── 模型凭据（回退配置，见文件头约定）───────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxx              # DeepSeek API Key（JSON 留空时生效）
DEEPSEEK_API_BASE=https://api.deepseek.com # DeepSeek API Base URL

# ── 地图（可选，用于地图/天气工具）───────────────────────────────────────────
AMAP_API_KEY=你的高德Key

# ── 数据与工作区 ────────────────────────────────────────────────────────────
USER_DATA_ROOT=/path/to/store/users/data  # 用户数据根目录（记忆/会话/工作区）
MAX_SPECIAL_SESSIONS=3                    # 每用户最大特殊会话数（默认，实际按角色）
USER_WORKSPACE_QUOTA_MB=500               # 每用户工作区配额 MB（默认，实际按角色）

# ── 性能 ────────────────────────────────────────────────────────────────────
BUFF_DETECTOR_WORKERS=2                   # 团战测速 BuffDetector 并行匹配线程数
                                          #   （cv2.matchTemplate 为 CPU 密集且释放 GIL；
                                          #     按部署机型核数调整，下限 1）

# ── 兑换码抓取（可选）───────────────────────────────────────────────────────
# 兑换码以 WebUI「兑换码管理」页人工维护为主（_source=panel，权威）；
# ucngame 自动抓取为辅。ucngame 有 Cloudflare JS 挑战，纯 HTTP 过不去，
# 需启用下方 ruyiPage 浏览器引擎（见 scripts/install_redeem_browser.sh）。
# 全部留空 = 维持人工维护，不启动浏览器。
# REDEEM_CODE_PROXY=http://127.0.0.1:1081  # HTTP 抓取代理（回退 HTTPS_PROXY）
# REDEEM_CODE_BROWSER=ruyipage             # 设为 ruyipage 才启用浏览器引擎
# REDEEM_CODE_BROWSER_PYTHON=$HOME/.virtualenvs/ruyipage/bin/python
#                                          # 装有 ruyiPage 的解释器（默认该独立 venv）
# REDEEM_CODE_BROWSER_TIMEOUT=90           # 单次抓取超时秒数（冷启动 Firefox 较慢）
# 注：浏览器引擎在后台任务中刷新，不阻塞用户 /兑换码 回复；需要 xvfb-run。

# ── 可选：外部服务地址（缺省使用内置默认值）──────────────────────────────────
# SEARXNG_ENDPOINT=http://localhost:8082   # SearXNG 搜索服务地址
# NAPCAT_HTTP_BASE=http://127.0.0.1:6099   # NapCat HTTP 服务地址
# WIKI_PROXY=http://127.0.0.1:1081         # wiki 抓取代理
# QQBOT_WORKSPACE=/path/to/workspace       # 覆盖默认工作区目录

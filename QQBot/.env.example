# ============================================================================
# QQBot 环境变量说明（复制为 .env 后填写）
#   cp .env.example .env
#
# 约定：
#   * 本文件是 .env 的「说明文档 + 模板」，逐行注释每个变量的含义与取值。
#   * 模型凭据遵循「models_settings.json 优先、.env 回退」：
#     在 config/models_settings.json 中为某模型段填写 api_key/api_base 后，
#     该段即覆盖 .env 的 DEEPSEEK_API_KEY / DEEPSEEK_API_BASE。
#     只有 JSON 段留空（或文件缺失）时，才回退到 .env 的 DeepSeek 配置。
#   * 布尔/列表值直接写 JSON 字面量，例如 SUPERUSERS=["123","456"]。
# ============================================================================

# ── NoneBot 服务 ────────────────────────────────────────────────────────────
DRIVER=~fastapi+~httpx+~websockets
#   ~fastapi    必选：HTTP 服务端（NapCat 反向 WS 也走它）
#   ~httpx      QQ 官方路由调用开放平台 REST API 需要
#   ~websockets QQ 官方路由的 websocket 客户端需要
#   （只跑 OneBot/NapCat 路由时 ~fastapi 即可）
HOST=0.0.0.0             # 监听地址
PORT=8081                # 监听端口（NapCat 反向 WS 连接到此端口）

# ── OneBot / QQ 协议 ────────────────────────────────────────────────────────
ONEBOT_ACCESS_TOKEN=你的Token   # 必须与 NapCat WebUI 中配置的 token 完全一致
COMMAND_START=["/", ""]        # 命令起始符（"" 表示也响应纯文本）
COMMAND_SEP=[" "]              # 命令与参数分隔符

# ── QQ 官方机器人路由（可选，与 OneBot 路由并存）─────────────────────────────
# 在 q.qq.com 创建机器人后填写；appid+secret 属敏感凭据。
# 仅在 bot 启动时读取（nonebot-adapter-qq 建 websocket 连接），
# 修改后需重启 NoneBot —— WebUI「配置热管理」不编辑此项。
# 运行状态见 WebUI 仪表盘「QQ 官方路由」卡片（心跳文件 data/official_status.json）。
# QQ_BOTS=[{"id":"appid","secret":"secret","use_websocket":true}]

# 官方路由 markdown（msg_type=2）逃生门。默认开启：unified 人格回复、
# /帮助、/兑换码 等走原生 markdown（单聊/群聊自定义 md 自 2026/04 起对所有
# 机器人开放，无需申请模板）。设为 off 时全部降级为纯文本（热读，改后即生效，
# 无需重启）；平台连续拒收 markdown 时另有进程内熔断器自动降级 10 分钟。
# 注意：OneBot 路由永远纯文本，此项只影响官方路由。
# QQ_OFFICIAL_MARKDOWN=on                     # on（默认）/ off

# ── 官方路由消息按钮（keyboard / inline buttons，buttons-design §6.8）───────
# 键盘只能骑在 markdown（msg_type=2）上，故 QQ_OFFICIAL_BUTTONS 的可用性已内含
# _md_available()——QQ_OFFICIAL_MARKDOWN=off 时按钮自动全量降级为纯文本命令清单，
# 无需单独关此项。所有项热读（改后即生效，无需重启）；OneBot 路由不受影响。
# QQ_OFFICIAL_BUTTONS=auto        # auto（默认，能力探测+熔断）/ on（强制）/ off（禁用）
# QQ_OFFICIAL_BUTTONS_CIRCUIT_HOURS=24   # 平台明确不支持（304037）后的熔断时长（小时）
# QQ_OFFICIAL_BUTTONS_MAX_ROWS=5         # 键盘排版行数上限（env 热读，绝不超过平台硬上限 5）
# QQ_OFFICIAL_BUTTONS_MAX_PER_ROW=3      # 每行按钮数上限（绝不超过平台硬上限 5，窄排版利于手机屏）
# QQ_OFFICIAL_BUTTONS_USERS=             # 灰度白名单（openid，逗号分隔；留空=全量放开）
# QQ_OFFICIAL_BUTTONS_AUDIT=             # 点击审计 JSONL 路径（缺省 data/official_buttons_audit_YYYY-MM-DD.jsonl）
#
# 回调按钮（P1，INTERACTION_CREATE）须在生产 QQ_BOTS 里授权 interaction intent：
#   QQ_BOTS=[{"id":"appid","secret":"secret","use_websocket":true,
#             "intent":{"c2c_group_at_messages":true,"interaction":true}}]
# 未授权的 intent 会导致 WS 鉴权断连——务必先在沙箱验证再上生产。
# 指令按钮（P0，type=2 替用户打字）不需要 interaction intent，可单独先上。

# ── 权限（两条路由各自独立名单，JSON 数组字符串）─────────────────────────────
# OneBot 路由按 QQ 号匹配；QQ 官方路由按 openid（不透明字母数字串）匹配。
# openid 采集：官方路由每条入站消息都会在 bot 日志打印 [qq_official] … openid=…。
# 四张表均由 PermissionManager 每次调用重读 .env，保存后立即生效
# （WebUI「配置热管理 → 权限名单」可编辑）。
SUPERUSERS=["管理员QQ号1", "管理员QQ号2"]   # OneBot 管理员（全部工具）
VIP_USERS=["VIPQQ号1"]                      # 可选；OneBot VIP（部分特权工具）
# QQ_OFFICIAL_SUPERUSERS=["openid1"]        # 官方路由管理员（openid）
# QQ_OFFICIAL_VIP_USERS=["openid2"]         # 官方路由 VIP（openid）

# ── 模型凭据（回退配置，见文件头约定）───────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxx              # DeepSeek API Key（JSON 留空时生效）
DEEPSEEK_API_BASE=https://api.deepseek.com # DeepSeek API Base URL

# ── 地图（可选，用于地图/天气工具）───────────────────────────────────────────
AMAP_API_KEY=你的高德Key

# ── 数据与工作区 ────────────────────────────────────────────────────────────
USER_DATA_ROOT=/path/to/store/users/data  # 用户数据根目录（记忆/会话/工作区）
# 原作剧情知识库位置（可选）：默认 $USER_DATA_ROOT/story_kb
# STORY_KB_DIR=/mnt/datadisk0/QQBotUserData/story_kb
# 用户产生的不可替代状态目录（可选）：缺省在 QQBot/data/ 下；生产建议与
# USER_DATA_ROOT 同指数据盘（备份单树化）。缓存类与临时会话不受影响。
# CHARACTERS_DIR=/mnt/datadisk0/QQBotUserData/characters   # UGC 角色卡+meta
# BONDS_DIR=/mnt/datadisk0/QQBotUserData/bonds             # 好感/心情/陪伴（bond_events 自动同级）
# MEMORY_DIR=/mnt/datadisk0/QQBotUserData/memory           # 长期记忆+tiers（WebUI 记忆页同源读取）
# ASSETS_DIR=/mnt/datadisk0/QQBotUserData/assets           # P5 多模态资产（图/语音，会持续增长）
MAX_SPECIAL_SESSIONS=3                    # 每用户最大特殊会话数（默认，实际按角色）
MAX_SCENE_ARCHIVES=20                     # 剧情会话总量上限（含进行中与已完结；不计普通配额）
                                          #   剧情/创作会话豁免特殊会话配额；完结后自动封档可 /切换会话 回看。
                                          #   紧急回滚：SCENE_ARCHIVE_ENABLED=0 退回改造前统一配额语义（热读生效）。
USER_WORKSPACE_QUOTA_MB=500               # 每用户工作区配额 MB（默认，实际按角色）

# ── 性能 ────────────────────────────────────────────────────────────────────
BUFF_DETECTOR_WORKERS=2                   # 团战测速 BuffDetector 并行匹配线程数
                                          #   （cv2.matchTemplate 为 CPU 密集且释放 GIL；
                                          #     按部署机型核数调整，下限 1）

# ── 兑换码抓取（可选）───────────────────────────────────────────────────────
# 兑换码以 WebUI「兑换码管理」页人工维护为主（_source=panel，权威）；
# ucngame 自动抓取为辅。ucngame 有 Cloudflare JS 挑战，纯 HTTP 过不去，
# 需启用下方 ruyiPage 浏览器引擎（见 scripts/install_redeem_browser.sh）。
# 全部留空 = 维持人工维护，不启动浏览器。
# REDEEM_CODE_PROXY=http://127.0.0.1:1081  # HTTP 抓取代理（回退 HTTPS_PROXY）
# REDEEM_CODE_BROWSER=ruyipage             # 设为 ruyipage 才启用浏览器引擎
# REDEEM_CODE_BROWSER_PYTHON=$HOME/.virtualenvs/ruyipage/bin/python
#                                          # 装有 ruyiPage 的解释器（默认该独立 venv）
# REDEEM_CODE_BROWSER_TIMEOUT=90           # 单次抓取超时秒数（冷启动 Firefox 较慢）
# 注：浏览器引擎在后台任务中刷新，不阻塞用户 /兑换码 回复；需要 xvfb-run。

# ── web_fetch 抗反爬（可选）──────────────────────────────────────────────────
# Tier 1（curl_cffi chrome131 TLS 指纹伪装）默认生效，无需配置，可绕过绝大多数
#   基于 TLS 指纹/WAF 的机器人阻挡。
# Tier 2（ruyiPage 无头 Firefox 兜底）默认休眠；仅当 Tier 1 仍被 Cloudflare JS
#   挑战挡住、且管理员显式开启时才触发。复用兑换码那套浏览器引擎（同一 venv、
#   同一并发闸），需先 bash scripts/install_redeem_browser.sh 装好 xvfb+Firefox。
# WEB_FETCH_BROWSER=ruyipage               # 设为 ruyipage 才启用 Tier 2 浏览器兜底
# WEB_FETCH_BROWSER_TIMEOUT=45             # 单次浏览器抓取超时秒数（比兑换码短，避免拖住 agent）
# BROWSER_FETCH_MAX_CONCURRENCY=2          # 整机并发 Firefox 上限（兑换码 + web_fetch 共享）
# BROWSER_FETCH_PYTHON=$HOME/.virtualenvs/ruyipage/bin/python
#                                          # 共享解释器覆盖（回退 REDEEM_CODE_BROWSER_PYTHON）
# 注：Tier 2 会对浏览器重定向后的最终 URL 复跑 SSRF 校验，命中内网/元数据地址即丢弃。

# ── 可选：外部服务地址（缺省使用内置默认值）──────────────────────────────────
# SEARXNG_ENDPOINT=http://localhost:8082   # SearXNG 搜索服务地址
# NAPCAT_HTTP_BASE=http://127.0.0.1:6099   # NapCat HTTP 服务地址
# WIKI_PROXY=http://127.0.0.1:1081         # wiki 抓取代理
# QQBOT_WORKSPACE=/path/to/workspace       # 覆盖默认工作区目录
